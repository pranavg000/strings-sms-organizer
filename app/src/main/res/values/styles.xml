<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OtpDigitSmall" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:background">@drawable/otp_digit_bg</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="OtpDigitLarge" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:background">@drawable/otp_digit_bg</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
